# Guild Applications Worker local development variables.
# Copy to `.dev.vars` for local `wrangler dev` only.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# Firebase application storage
# -----------------------------------------------------------------------------
# New guild applications are stored in Firestore, not GitHub Issues.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_APPLICATIONS_COLLECTION="guildApplications"
GUILD_APPLICATIONS_LABEL="guild-application"
# Optional numeric salt for the date-encoded public tracking number. Keep stable after first deploy.
APPLICATION_NUMBER_DATE_SALT="730201"

# Optional legacy GitHub values kept only for old non-application integrations.
GITHUB_TOKEN=""
GITHUB_OWNER="LihvoDruida"
GITHUB_REPO="lihvodruida.github.io"
GITHUB_USER_AGENT="guild-applications-worker"

# Character verification for applications.
BATTLENET_CLIENT_ID=""
BATTLENET_CLIENT_SECRET=""
BATTLENET_LOCALE="en_GB"

# -----------------------------------------------------------------------------
# CORS / public URLs
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS="https://lihvodruida.pp.ua,https://www.lihvodruida.pp.ua,https://admin.lihvodruida.pp.ua,http://127.0.0.1:4000,http://localhost:4000,http://localhost:3000"
SITE_BASE_URL="https://lihvodruida.pp.ua"
PUBLIC_SITE_URL="https://lihvodruida.pp.ua"
DASHBOARD_URL="https://admin.lihvodruida.pp.ua"
ADMIN_DASHBOARD_URL="https://admin.lihvodruida.pp.ua"

# -----------------------------------------------------------------------------
# Discord Application / Bot
# -----------------------------------------------------------------------------
# Create a Discord Developer Application, add Bot, invite bot with:
# Send Messages, Embed Links, Read Message History, Manage Roles, Kick Members.
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
# Optional dedicated fallback for raid announcements/channel picker.
# If /api/discord-guild-channels cannot list channels, this ID is still returned to the dashboard.
DISCORD_RAID_CHANNEL_ID=""
# Optional alias for the application publication channel. DISCORD_CHANNEL_ID is enough if this is empty.
GUILD_APPLICATIONS_DISCORD_CHANNEL_ID=""
DISCORD_GUILD_ID=""
# Optional aliases accepted by the channel-list endpoint if DISCORD_GUILD_ID is not set.
DISCORD_SERVER_ID=""
GUILD_ID=""
DISCORD_GUILD_NAME="Mistblossom Vanguard"
DISCORD_PUBLIC_KEY=""

# Optional, comma-separated Discord role IDs allowed to accept/decline applications.
# Leave empty to avoid Worker-side moderator role restriction.
DISCORD_ALLOWED_ROLES=""

# -----------------------------------------------------------------------------
# Dashboard profile lookup / raid integrations
# -----------------------------------------------------------------------------
# Worker uses this to verify that the Discord user authorized in dashboard
# and selected a main character.
# Optional. If empty, Worker derives /api/profile/discord-lookup from DASHBOARD_URL.
DASHBOARD_PROFILE_LOOKUP_ENDPOINT=""
# Deprecated alias; keep empty unless migrating old environments.
ADMIN_PROFILE_LOOKUP_ENDPOINT=""

# Must match the dashboard server-to-server secret.
INTERNAL_PROFILE_LOOKUP_TOKEN="replace_with_same_value_as_dashboard"

# Raid announcement buttons proxy. Used when Discord Interaction Endpoint points to this Worker.
# The {raidId} placeholder is replaced by Worker. If omitted, Worker builds this URL from ADMIN_DASHBOARD_URL.
DASHBOARD_RAID_ACTION_ENDPOINT="https://admin.lihvodruida.pp.ua/api/raids/{raidId}/discord-action"

# Raid-poll Discord vote proxy. The {pollId} placeholder is replaced by Worker.
# Token is INTERNAL_PROFILE_LOOKUP_TOKEN / DISCORD_RULES_STATS_TOKEN / WORKER_STATS_TOKEN and must match dashboard.
DASHBOARD_RAID_POLL_VOTE_ENDPOINT="https://admin.lihvodruida.pp.ua/api/polls/{pollId}/vote"

# Raid lifecycle cron proxy. Worker scheduled events call this dashboard endpoint.
# RAID_LIFECYCLE_SECRET must match dashboard RAID_LIFECYCLE_SECRET/CRON_SECRET.
DASHBOARD_RAID_LIFECYCLE_ENDPOINT="https://admin.lihvodruida.pp.ua/api/raids/lifecycle?limit=100"
# Optional: Worker scheduled events also close overdue raid-polls through this dashboard endpoint.
DASHBOARD_RAID_POLL_CLOSE_DUE_ENDPOINT="https://admin.lihvodruida.pp.ua/api/polls/close-due"
RAID_LIFECYCLE_SECRET="replace_with_same_value_as_dashboard"
RAID_DISCORD_DELETE_AFTER_START_HOURS="4"
RAID_DISCORD_DELETE_AFTER_CLOSE_MINUTES="60"

# Optional: public Discord message / page with raid rules.
# Used in Worker replies when a user is not authorized or has no selected main character.
RAID_RULES_URL="https://discord.com/channels/1449767281453301865/1498719949550784540/1498732894326227024"
# Aliases supported by Worker.
DISCORD_RAID_RULES_URL=""
NEXT_PUBLIC_RAID_RULES_URL=""

# -----------------------------------------------------------------------------
# Cloudflare Access Service Auth for protected admin dashboard
# -----------------------------------------------------------------------------
# Required only when admin.lihvodruida.pp.ua is protected by Cloudflare Access.
# Create a Cloudflare Access Service Token and allow it in the Access policy.
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
# Deprecated aliases; keep empty unless migrating old environments.
CLOUDFLARE_ACCESS_CLIENT_ID=""
CLOUDFLARE_ACCESS_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Stats / dashboard read tokens
# -----------------------------------------------------------------------------
# Optional but recommended: protects:
# - GET /api/discord-rules-stats
# - GET /api/discord-raid-rules-stats
# - GET /api/discord-raid-rules-signups
# - POST /api/discord-raid-message
# - GET /api/discord-guild-channels
# Set the same value in the dashboard.
DISCORD_RULES_STATS_TOKEN=""
# Optional alias if this Worker already uses a generic stats token.
WORKER_STATS_TOKEN=""

# Must match the dashboard value. Used to sign /rules/accept?rt=... links created from Discord interactions.
DASHBOARD_RULES_TOKEN_SECRET="replace_with_same_value_as_dashboard"
# Optional legacy alias accepted by both Worker and Dashboard.
RULES_TOKEN_SECRET=""

# -----------------------------------------------------------------------------
# Debug / behavior
# -----------------------------------------------------------------------------
# Keep debug query responses disabled in production.
ALLOW_DEBUG_QUERY="0"
DEBUG_LOGS="0"
DEBUG_RESPONSES="0"
# 1/unset: queue Discord notification with ctx.waitUntil. 0: wait synchronously.
APPLICATION_DISCORD_ASYNC="1"

# -----------------------------------------------------------------------------
# Cloudflare KV binding note
# -----------------------------------------------------------------------------
# RULES_STATS is not set in .dev.vars. It must be configured as a KV binding
# in wrangler.toml or via local Wrangler binding config.
# Create once:
# wrangler kv namespace create RULES_STATS
# Then add:
# [[kv_namespaces]]
# binding = "RULES_STATS"
# id = "paste_kv_namespace_id_here"

# -----------------------------------------------------------------------------
# Geo access guard for guild application submissions
# -----------------------------------------------------------------------------
# Defaults block applications from RU and BY. Dashboard /admin writes the live
# policy to Firebase dashboardSettings/geoAccessPolicy; Worker caches it briefly.
# Values are stored as ISO alpha-2; aliases RUS/643 and BLR/112 normalize to RU/BY.
GEO_ACCESS_BLOCK_ENABLED="true"
GEO_ACCESS_BLOCKED_COUNTRIES="RU,BY"
GEO_ACCESS_BLOCK_APPLICATIONS="true"
GEO_ACCESS_BLOCK_UNKNOWN_COUNTRIES="false"
GEO_ACCESS_POLICY_CACHE_SECONDS="60"

# Public API cache token for dashboard <-> Worker cache writes/invalidations.
PUBLIC_API_CACHE_TOKEN=
PUBLIC_API_CACHE_TTL_SECONDS=120
PUBLIC_API_APPLICATIONS_CACHE_SECONDS=90
PUBLIC_API_RULES_STATS_CACHE_SECONDS=60
PUBLIC_API_SIGNUPS_CACHE_SECONDS=45
PUBLIC_API_DISCORD_CHANNELS_CACHE_SECONDS=900
# API stability / access separation
DISCORD_API_TIMEOUT_MS=14000
DASHBOARD_API_TIMEOUT_MS=9000
DISCORD_SIGNATURE_MAX_SKEW_SECONDS=120
PUBLIC_API_CACHE_ALLOW_SHARED_TOKEN=0
PUBLIC_API_CACHE_VERSION=v1

# Worker state KV binding is configured in wrangler.toml, not here.
# Used for cooldowns, idempotency, Firebase OAuth token cache and application numbering high-water mark.
