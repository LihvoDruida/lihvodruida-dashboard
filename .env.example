# Mistblossom Vanguard — docker-compose stack
# Copy to .env and keep the real file secret: chmod 600 .env

DASHBOARD_PUBLIC_URL=https://guild.lihvodruida.pp.ua
POSTGRES_DB=mistblossom
POSTGRES_USER=mistblossom
POSTGRES_PASSWORD=

# Canonical Discord signature key for dashboard + bot.
DISCORD_PUBLIC_KEY=
# One canonical bearer token for dashboard + bot + cron. Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=

LETSENCRYPT_EMAIL=
IMAGE_TAG=latest
BOT_LOG_LEVEL=info
NEXT_BUILD_CPUS=2
NODE_BUILD_MEMORY_MB=2560
BUILD_CACHE_KEEP_STORAGE=6GB
BUILD_CACHE_MAX_AGE=168h
AUTO_PRUNE_BUILD_CACHE=1
