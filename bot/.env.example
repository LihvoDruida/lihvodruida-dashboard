# ---------------------------------------------------------------------------
# Discord-бот Mistblossom Vanguard
#
# Скопіюйте у bot/.env.production. Це окремий файл від панелі навмисно:
# бот не має бачити ні рядок підключення до бази, ні ключі Battle.net —
# йому вони не потрібні, а зайвий секрет у контейнері — зайвий ризик.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Public Key застосунку. Ним перевіряється підпис кожної взаємодії; без нього
# бот відхилятиме всі запити з 401.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_APPLICATION_ID=

# --- Панель ----------------------------------------------------------------
# Внутрішні адреси в docker-мережі. Публічний URL тут вказувати не треба:
# трафік між нашими ж сервісами не має виходити назовні й повертатись.
DASHBOARD_URL=http://dashboard:3000
DASHBOARD_INTERNAL_URL=http://dashboard:3000
DASHBOARD_PROFILE_LOOKUP_ENDPOINT=http://dashboard:3000/api/profile/discord-lookup
DASHBOARD_RECRUITMENT_ADVICE_MESSAGE_ENDPOINT=http://dashboard:3000/api/discord/recruitment-advice/message
DASHBOARD_RECRUITMENT_ADVICE_SCAN_ENDPOINT=http://dashboard:3000/api/discord/recruitment-advice?limit=4

# Спільний секрет для внутрішніх запитів бот → панель. Має збігатися зі
# значенням у dashboard/.env.production.
INTERNAL_API_TOKEN=
WORKER_SHARED_SECRET=

# --- Планувальник ----------------------------------------------------------
# Замінює Cloudflare Cron Triggers. Обробники ідемпотентні, тому пропущений
# або подвоєний запуск нічого не ламає.
BOT_CRON_ENABLED=1
BOT_CRON_INTERVAL_MS=600000
BOT_CRON_INITIAL_DELAY_MS=30000

# --- Кеш публічного API ----------------------------------------------------
# Замість Cloudflare KV — кеш у памʼяті процесу. Дані тут суто похідні
# (статистика правил, список каналів), їхня втрата при рестарті коштує
# один зайвий запит до Discord.
BOT_CACHE_MAX_ENTRIES=500
PUBLIC_API_CACHE_TTL_SECONDS=120
PUBLIC_API_RULES_STATS_CACHE_SECONDS=60
PUBLIC_API_SIGNUPS_CACHE_SECONDS=45
PUBLIC_API_DISCORD_CHANNELS_CACHE_SECONDS=900

# --- Інше ------------------------------------------------------------------
ALLOWED_ORIGINS=https://lihvodruida.pp.ua,https://dashboard.lihvodruida.pp.ua
DISCORD_API_TIMEOUT_MS=14000
DASHBOARD_API_TIMEOUT_MS=9000
RAID_RULES_URL=
DEBUG_LOGS=0
