# ---------------------------------------------------------------------------
# Discord-бот Mistblossom Vanguard
#
# Скопіюйте у bot/.env.production. Це окремий файл від панелі навмисно:
# бот не має бачити ні рядок підключення до бази, ні ключі Battle.net —
# йому вони не потрібні, а зайвий секрет у контейнері — зайвий ризик.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Public Key застосунку. Ним перевіряється підпис кожної взаємодії; без нього
# бот відхилятиме всі запити з 401.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Timeout for editing deferred Discord interaction responses.
DISCORD_TIMEOUT_MS=10000
# Мінімальний рівень, який бот дублює у локальний PostgreSQL-журнал dashboard.
# Це НЕ Discord mirror: у Discord дублюється тільки Security.
BOT_LOG_SINK_LEVEL=info


# --- Панель ----------------------------------------------------------------
# Внутрішні адреси в docker-мережі. Публічний URL тут вказувати не треба:
# трафік між нашими ж сервісами не має виходити назовні й повертатись.
DASHBOARD_URL=http://dashboard:3000
DASHBOARD_INTERNAL_URL=http://dashboard:3000
# Timeout for bot -> dashboard interaction relay.
DASHBOARD_TIMEOUT_MS=20000

# Спільний секрет для внутрішніх запитів бот → панель. Має збігатися зі
# значенням у dashboard/.env.production.
INTERNAL_API_TOKEN=
