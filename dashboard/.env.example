GITHUB_OWNER=LihvoDruida
GITHUB_REPO=lihvodruida.github.io
GITHUB_TOKEN=github_pat_or_classic_token_with_issues_and_contents_write
GUILD_APPLICATIONS_LABEL=guild-application

# Minimum 32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-random-32-plus-character-secret
# Shared HMAC secret for no-OAuth rules acceptance links generated by the dashboard/bot flow.
# Keep it server-side. If empty, code tries DISCORD_BOT_TOKEN as a shared fallback, then session secrets.
DASHBOARD_RULES_TOKEN_SECRET=
SESSION_MAX_AGE_SECONDS=604800

NEXT_PUBLIC_DASHBOARD_URL=https://guild.lihvodruida.pp.ua
DASHBOARD_URL=https://guild.lihvodruida.pp.ua
DASHBOARD_ALLOWED_HOSTS=guild.lihvodruida.pp.ua

# Cloudflare header check mode: false/off disables, true/warn logs only, strict blocks.
# Use strict only after the dashboard domain is confirmed to be proxied through Cloudflare.
SECURITY_REQUIRE_CLOUDFLARE=false

# Keep false behind Cloudflare unless you confirm Origin/Referer/Sec-Fetch-* survive the proxy.
SECURITY_STRICT_ORIGIN_CHECKS=false

# Override only if you are not ready for includeSubDomains.
SECURITY_HSTS_HEADER=max-age=31536000; includeSubDomains

# Server logs (docker compose logs dashboard). Info/warn/error are always emitted for critical actions.
# Debug logs are opt-in to avoid noisy production logs.
DASHBOARD_DEBUG_LOGS=false
SECURITY_DEBUG_LOGS=false

# Discord OAuth is the main login method.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Discord server used for login and owner detection.
# Dashboard access groups and Discord role ID are managed in the configured database on /dashboard/groups.
# System group IDs: admin=1, moderator=2, mentor=3, member=99. Only 1, 2 and 99 have fixed IDs.
DISCORD_GUILD_ID=
# Bot must be in the guild and able to read members/bans. Auth blocks banned users and removes profiles for users who left the guild.
# For ban checks, the bot needs permission to view guild bans.
# How often signed-in Discord users are re-checked against live server roles.
# Requires DISCORD_BOT_TOKEN + DISCORD_GUILD_ID. If Discord is unavailable, elevated roles are downgraded to member until the next successful check.
DISCORD_LIVE_ACCESS_SYNC_SECONDS=90
# Cache Discord role-name lookups used for profile access previews.
DISCORD_ROLES_CACHE_SECONDS=300

# Emergency fallback only. Admin role. Keep secret and rotate after use.
ADMIN_DASHBOARD_TOKEN=

RAIDERIO_ENABLED=true
RAIDERIO_CONCURRENCY=6
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# /dashboard/logs uses Discord as the audit-log storage.
# Keep only DISCORD_BOT_TOKEN in env; channel/level/system-log options are managed in the dashboard UI.
DISCORD_GUILD_NAME=Mistblossom Vanguard

# Branch where the dashboard commits site news/guides/images.
GITHUB_CONTENT_BRANCH=main

# Raid announcement image picker.
# Images are listed from GitHub and inserted into the raid image URL input.
RAID_IMAGES_BRANCH=live
RAID_IMAGES_DIRECTORY=assets/img/raids-img
RAID_IMAGES_PUBLIC_BASE_URL=https://lihvodruida.pp.ua

# Public website used for content previews and already published images.
NEXT_PUBLIC_SITE_BASE_URL=https://lihvodruida.pp.ua
SITE_BASE_URL=https://lihvodruida.pp.ua

# ---------------------------------------------------------------------------
# DISCORD-БОТ (окремий сервіс, каталог bot/)
#
# Взаємодії приймає власний бот, а не Cloudflare Worker. У Discord Developer
# Portal як Interactions Endpoint URL треба вказати:
#   https://<домен>/discord/interactions
#
# Маршрут панелі /api/discord/interactions ззовні закритий (nginx: deny all),
# щоб взаємодії не можна було надіслати в обхід перевірки підпису.
# ---------------------------------------------------------------------------
DISCORD_INTERACTIONS_ENDPOINT=https://guild.lihvodruida.pp.ua/discord/interactions
# Публічний ключ застосунку Discord. Потрібен і панелі, і боту: обидва
# перевіряють підпис незалежно (захист у глибину).
DISCORD_PUBLIC_KEY=
# ID застосунку. Боту потрібен, щоб редагувати відкладену відповідь.
DISCORD_APPLICATION_ID=
# Спільний токен «бот → панель». Згенеруйте: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Скільки бот чекає на панель. Discord дає 15 хвилин, тож запас великий.
DASHBOARD_TIMEOUT_MS=20000
BOT_LOG_LEVEL=info
# Optional dashboard stats for rules buttons. Default is derived from DISCORD_INTERACTIONS_ENDPOINT.
# Public link shown when a user must read/confirm raid rules before signup.
RAID_RULES_URL=https://discord.com/channels/1449767281453301865/1498719949550784540/1498732894326227024

# Firestore compatibility credentials. Needed only while running/migrating without DATABASE_URL.
# Store these only in .env.production on the server, never as NEXT_PUBLIC_*.

# ---------------------------------------------------------------------------
# СХОВИЩЕ ДАНИХ
#
# Задано DATABASE_URL  → власний PostgreSQL (цільовий режим).
# Не задано, але є ключі Firebase → Firestore (режим сумісності на час
# перенесення даних; відкат робиться прибиранням DATABASE_URL).
#
# У docker-compose хост — це імʼя сервісу `postgres`, а не localhost.
# Порядок переїзду: docs/ua/DATABASE_MIGRATION.md
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://mistblossom:пароль@postgres:5432/mistblossom
# Розмір пулу зʼєднань. Має бути помітно меншим за max_connections бази.
DATABASE_POOL_SIZE=10
# TLS до бази. Для локального Postgres на тому ж хості не потрібен.
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=0

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Firestore collection used by the new guild application system.
FIREBASE_APPLICATIONS_COLLECTION=guildApplications
# Optional numeric salt for date-encoded guild application tracking numbers. Keep stable.
APPLICATION_NUMBER_DATE_SALT=730201
# Optional separate HMAC secret for stable /profile/id... URLs. Falls back to SESSION_SECRET.
PROFILE_ID_SECRET=

# Member/admin/moderator access is no longer configured here.
# Add Discord role ID to Firebase access groups on /dashboard/groups.

# Battle.net OAuth + World of Warcraft Profile API.
# Redirect URI in Battle.net Developer Portal:
# https://guild.lihvodruida.pp.ua/api/auth/battlenet/callback
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_LOCALE=en_GB
# Enabled Battle.net regions in the profile UI. For Mistblossom Vanguard keep only EU.
BATTLENET_ENABLED_REGIONS=eu
# Optional fallback only. Real region is selected by the profile UI during Battle.net authorization.
BATTLENET_DEFAULT_REGION=eu
# Leave BATTLENET_SCAN_CONCURRENCY empty/0 for adaptive async worker pool based on server CPU hint.
BATTLENET_SCAN_CONCURRENCY=0
BATTLENET_SCAN_MAX_CONCURRENCY=12
BATTLENET_REQUEST_TIMEOUT_MS=10000
BATTLENET_REQUEST_RETRIES=2
BATTLENET_CANDIDATE_TTL_MINUTES=30
WOW_GUILD_NAME=Mistblossom Vanguard
# Optional strict realm check. Leave empty if the guild can move/merge realms.
WOW_GUILD_REALM=

# Internal API for bot lookup by Discord user id.
# This is a private server-to-server bearer token, not a user token.
# Generate with: openssl rand -hex 32
# GET /api/profile/discord-lookup?discord_id=...
# Authorization: Bearer <INTERNAL_PROFILE_LOOKUP_TOKEN>
INTERNAL_PROFILE_LOOKUP_TOKEN=

# Adaptive multi-tasking / batch processing. Leave 0/empty to auto-scale from runtime CPU hint.
DASHBOARD_MAX_CONCURRENCY=16
RAIDERIO_LOOKUP_CONCURRENCY=0
RAIDERIO_LOOKUP_MAX_CONCURRENCY=8
CONTENT_READ_CONCURRENCY=0
CONTENT_READ_MAX_CONCURRENCY=12
GITHUB_STATUS_CLEANUP_CONCURRENCY=0
APPLICATION_BULK_STATUS_CONCURRENCY=0
APPLICATION_BULK_STATUS_MAX_CONCURRENCY=4
DISCORD_ROLE_ASSIGN_CONCURRENCY=0
DISCORD_ROLE_ASSIGN_MAX_CONCURRENCY=5

# Legacy shared-token notes removed: Discord interactions and stats are served by the local bot/dashboard stack.

# Raid announcement builder.
# Discord buttons use custom_id mbv1:raid:<raidId>:going|late|skipped.
# Discord interactions are handled by the local bot service.
RAID_ANNOUNCEMENTS_ENABLED=true
# Raid messages are published directly through Discord API by the dashboard.
# Optional channel list endpoint/cache. The raid/poll forms use only channels returned by Discord; manual Channel ID fallback is intentionally disabled.
DISCORD_CHANNELS_CACHE_SECONDS=300
# Optional override for scheduled closing of overdue raid-polls.
DASHBOARD_RAID_POLL_CLOSE_DUE_ENDPOINT=
# Optional explicit poll vote endpoint template for internal integrations.
DASHBOARD_RAID_POLL_VOTE_ENDPOINT=
# Timezone used to convert raid date/time into Discord timestamps.
# Discord then displays the timestamp in each viewer's local timezone and shows a relative countdown.
RAID_TIME_ZONE=Europe/Kyiv
NEXT_PUBLIC_RAID_TIME_ZONE=Europe/Kyiv
# Hours after raid start when the raid is auto-closed and Discord buttons are disabled.
RAID_DISCORD_DELETE_AFTER_START_HOURS=4
# Minutes after the closed state before the Discord announcement can be removed. Use 0 to allow immediate cleanup, 60 recommended.
RAID_DISCORD_DELETE_AFTER_CLOSE_MINUTES=60
RAID_LIFECYCLE_SECRET=

# Guild roster page (/guild). Runtime data comes from Battle.net Guild Roster API + Raider.IO.
# Falls back to WOW_REGION / WOW_REALM / WOW_GUILD_NAME when omitted.
GUILD_ROSTER_REGION=eu
GUILD_ROSTER_REALM=terokkar
GUILD_ROSTER_NAME=Mistblossom Vanguard
# Cache live roster in Firebase/in-memory for this many seconds to avoid hammering external APIs.
GUILD_ROSTER_CACHE_TTL_SECONDS=1800
# Cache map character -> owner profile for roster profile links.
PROFILE_CHARACTER_LINK_CACHE_SECONDS=120
# Optional safety knobs for large rosters. 1000 is supported, but data is refreshed in small resumable steps.
GUILD_ROSTER_REFRESH_CONCURRENCY=6
GUILD_ROSTER_REFRESH_MAX_CONCURRENCY=6
GUILD_ROSTER_MEMBER_LIMIT=1000
GUILD_ROSTER_REFRESH_STEP_BUDGET_MS=22000
GUILD_ROSTER_SYNC_JOB_TTL_SECONDS=1800
GUILD_ROSTER_SHARDED_CACHE_ENABLED=true
GUILD_ROSTER_SHARDED_CACHE_THRESHOLD=150
GUILD_ROSTER_CLIENT_DRIVEN_SYNC_ENABLED=true
GUILD_ROSTER_CLIENT_STEP_DELAY_MS=250
GUILD_ROSTER_CLIENT_REQUEST_TIMEOUT_MS=40000
GUILD_ROSTER_CLIENT_MAX_STEPS=2200
# Battle.net Profile API fills item level, avatar, active spec and role in small resumable steps.
GUILD_ROSTER_BATTLENET_STEP_SIZE=8
GUILD_ROSTER_BATTLENET_TTL_SECONDS=21600
# Raider.IO is processed as a resumable job step, not as one giant HTTP request.
GUILD_ROSTER_RAIDERIO_STEP_SIZE=5
GUILD_ROSTER_RAIDERIO_TTL_SECONDS=21600
RAIDERIO_ACCESS_KEY=
RAIDERIO_REQUEST_TIMEOUT_MS=10000
RAIDERIO_REQUEST_RETRIES=1
RAIDERIO_RATE_LIMIT_COOLDOWN_SECONDS=900
RAIDERIO_REQUEST_MIN_DELAY_MS=350
# Fallback only. Prefer /dashboard → “Фоновий API та автооновлення” → “Кеш та обсяг даних”.
RAIDERIO_CHARACTER_CACHE_TTL_MS=120000

# These env values are fallback only for old deploys or when Firebase settings are unavailable.
# Fallback only. Prefer /dashboard → “Кеш та обсяг даних”.
DASHBOARD_API_DEBUG_AUDIT_LOGS=0
DASHBOARD_API_WARNING_AUDIT_LOGS=1
# Background API refresh. Runtime-safe values can be managed from /dashboard → “Фоновий API та автооновлення”.
# Env values are only defaults/fallbacks for new installs or unavailable Firebase settings.
# Keep 600+ seconds to avoid hammering Battle.net/Raider.IO.
DASHBOARD_BACKGROUND_REFRESH_MIN_SECONDS=600
PROFILE_VIEW_REFRESH_MIN_SECONDS=600
PROFILE_CHARACTER_REFRESH_CONCURRENCY=0
PROFILE_CHARACTER_REFRESH_MAX_CONCURRENCY=8
# Optional server-to-server refresh endpoint:
# GET /api/dashboard/profiles/refresh-external-data?limit=50&minSpacingSeconds=1800
# Authorization: Bearer <PROFILE_REFRESH_SECRET>
PROFILE_REFRESH_SECRET=
PROFILE_EXTERNAL_REFRESH_BATCH_LIMIT=50
PROFILE_EXTERNAL_REFRESH_MIN_SECONDS=1800
PROFILE_EXTERNAL_REFRESH_CONCURRENCY=0
PROFILE_EXTERNAL_REFRESH_MAX_CONCURRENCY=6

# Discord nickname template and role cleanup concurrency are configured in /dashboard/discord.
# Defaults are stored by the dashboard settings document; no env variables are needed for these values.

# Geo access guard for applications/auth. Defaults can be managed from /dashboard.
# Stored country codes are ISO 3166-1 alpha-2. Admin UI also accepts aliases: RUS/643 -> RU, BLR/112 -> BY.
# Defaults block RU and BY for applications and auth.
GEO_ACCESS_BLOCK_ENABLED=true
GEO_ACCESS_BLOCKED_COUNTRIES=RU,BY
GEO_ACCESS_BLOCK_APPLICATIONS=true
GEO_ACCESS_BLOCK_AUTH=true
# Keep false unless you intentionally want to block requests without country signal.
GEO_ACCESS_BLOCK_UNKNOWN_COUNTRIES=false

# Discord auth / rules registration guard. Defaults can be managed from /dashboard.
# Safe default: if AUTH_ACCESS_REQUIRE_CONFIGURED_ROLE=true and no role is configured, only the Discord server owner can pass.
# Keep AUTH_ACCESS_ALLOW_EMERGENCY_TOKEN_LOGIN=false unless you need temporary break-glass access.
AUTH_ACCESS_RESTRICTIONS_ENABLED=true
AUTH_ACCESS_REQUIRE_CONFIGURED_ROLE=true
AUTH_ACCESS_ALLOW_SERVER_OWNER=true
AUTH_ACCESS_ALLOW_EMERGENCY_TOKEN_LOGIN=false
# Comma-separated Discord role IDs allowed to authorize/register through Discord OAuth.
AUTH_ACCESS_REQUIRED_ROLE_IDS=

# Server-side cache TTLs protecting Firebase from repeated page/policy reads.
# These stay in env because they are infrastructure safeguards, not content settings.
DASHBOARD_API_SETTINGS_CACHE_TTL_MS=300000
AUTH_ACCESS_POLICY_CACHE_TTL_MS=600000
GEO_ACCESS_POLICY_CACHE_TTL_MS=600000
ADMIN_AUDIT_POLICY_CACHE_TTL_MS=600000
GUILD_NICKNAME_POLICY_CACHE_TTL_MS=600000

# Runtime-safe Firebase quota knobs are managed from /dashboard → “Фоновий API та автооновлення”.
# Economy mode: safer defaults for free Firebase quota. Keep writes enabled unless the quota is already exhausted.
FIREBASE_ECO_MODE=1
# Emergency switches, leave 0 during normal work.
FIREBASE_READS_DISABLED=0
FIREBASE_WRITES_DISABLED=0
FIREBASE_ECO_READ_ONLY=0
RAID_LIFECYCLE_MIN_INTERVAL_MS=600000
RAID_POLL_CLOSE_DUE_MIN_INTERVAL_MS=600000
RAID_POLL_CLOSE_DUE_SCAN_LIMIT=20
DASHBOARD_BACKGROUND_API_RATE_LIMIT=20
INTEGRATION_STATUS_CACHE_TTL_MS=600000

# Keep the env values below only as first-install/fallback defaults when Firebase settings are unavailable.
# Discord audit page cache/dedupe fallback. Logs are stored in Discord, not in dashboardAdminAudit.
ADMIN_AUDIT_READ_CACHE_TTL_MS=120000
ADMIN_AUDIT_DEDUPE_WINDOW_MS=120000
ADMIN_AUDIT_MAX_STORED=250
GUILD_ROSTER_RECORDS_CHUNK_SIZE=64
# Legacy per-member roster docs are disabled by default to protect the no-cost Firestore quota.
# Deprecated guildRuntimeCache/guildRoster/members is no longer read by the site.
# Enable legacy reads/writes only for a short migration of old guildRosterRecords/members data.
GUILD_ROSTER_READ_LEGACY_MEMBER_DOCS=0
GUILD_ROSTER_WRITE_LEGACY_MEMBER_DOCS=0
# Guild roster cache writes: smaller batches reduce origin/Firestore pressure.
GUILD_ROSTER_CACHE_WRITE_BATCH_SIZE=25
# Keep disabled by default; deleting stale member docs during refresh can overload Firestore.
GUILD_ROSTER_CACHE_DELETE_STALE_MEMBERS=0

# Runtime resilience layer. Protects pages from Firebase quota and latency spikes.
ACCESS_GROUPS_CACHE_TTL_MS=600000
ACCESS_GROUPS_ENSURE_TTL_MS=600000
PROFILE_READ_CACHE_TTL_MS=300000
PROFILE_LIST_CACHE_TTL_MS=300000
PROFILE_CHARACTER_LINKS_CACHE_TTL_MS=600000
# Keep 0 in production: /guild resolves profile ownership through dashboardProfileCharacterLinks, not a dashboardProfiles scan.
PROFILE_CHARACTER_LINKS_SCAN_FALLBACK=0
PROFILE_CHARACTER_LINKS_SCAN_LIMIT=250
RAID_LIST_CACHE_TTL_MS=300000
RAID_ITEM_CACHE_TTL_MS=180000
# Published raids auto-close exactly at the scheduled start time.
# There is no grace delay: once the start moment is reached, signups close.
GUILD_ROSTER_CACHE_READ_TTL_MS=300000

# Page/session safety. Keep live Discord re-check off for page renders;
# API write actions still require a signed session cookie and page permissions.
SESSION_LIVE_ACCESS_SYNC_ENABLED=0

# Public API cache in the dashboard process. Keep cache controls server-side.
PUBLIC_API_RAIDS_CACHE_SECONDS=60
# Discord/API stability. Success logs are off by default to avoid noisy Discord/Vercel logs.
DISCORD_API_TIMEOUT_MS=14000
DISCORD_API_LOG_SUCCESS=0
# Keep cache token isolated. Only set to 1 for emergency migration from older shared-token setup.
PUBLIC_API_CACHE_ALLOW_SHARED_TOKEN=0

# Discord recruitment advisor / auto-replies.
# Runtime-параметри керуються з /dashboard/discord/recruitment і зберігаються
# у власній базі. Gateway працює всередині bot-контейнера, Cloudflare Worker
# для цього більше не потрібен.
DISCORD_RECRUITMENT_ADVICE_ENABLED=false
DISCORD_RECRUITMENT_ADVICE_DRY_RUN=false
# Спільний секрет bot -> dashboard. Може збігатися з INTERNAL_API_TOKEN.
DISCORD_RECRUITMENT_ADVICE_SECRET=
DISCORD_RECRUITMENT_ADVICE_LOOKBACK_HOURS=48
DISCORD_RECRUITMENT_ADVICE_MAX_CHANNELS=100
DISCORD_RECRUITMENT_ADVICE_MAX_PAGES=4
DISCORD_RECRUITMENT_ADVICE_MAX_REPLIES=4
DISCORD_RECRUITMENT_ADVICE_MANUAL_SCAN_LIMIT=4
DISCORD_RECRUITMENT_ADVICE_MIN_RIO=0
DISCORD_RECRUITMENT_ADVICE_MIN_ILVL=0
# Необов'язковий override control endpoint. За замовчуванням:
# http://bot:8080/discord/recruitment-gateway
DISCORD_RECRUITMENT_GATEWAY_ENDPOINT=

# ---------------------------------------------------------------------------
# ВНУТРІШНІ СЕРВІСИ
#
# Усе працює на нашому сервері. Cloudflare Workers, Cloudflare KV і Vercel
# більше не використовуються — між панеллю та ботом ходить внутрішня мережа
# docker, публічні URL між власними сервісами не потрібні.
# ---------------------------------------------------------------------------
# Адреса контейнера бота. За замовчуванням http://bot:8080.
BOT_INTERNAL_URL=http://bot:8080
# Спільний секрет для запитів панель ↔ бот. Має збігатися з bot/.env.production.
INTERNAL_API_TOKEN=
# Локальний кеш публічних даних (у памʼяті процесу).
PUBLIC_CACHE_TTL_SECONDS=120
# PUBLIC_CACHE_DISABLED=1
